# SETAD — Nginx reverse proxy
# Copiar para: /etc/nginx/sites-available/setad
# Ajustar server_name e ativar certbot

server {
    listen 80;
    listen [::]:80;
    server_name setad.org.br www.setad.org.br;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name setad.org.br www.setad.org.br;

    # Certbot preenche após: certbot --nginx -d setad.org.br -d www.setad.org.br
    # ssl_certificate /etc/letsencrypt/live/setad.org.br/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/setad.org.br/privkey.pem;

    client_max_body_size 15M;

    location / {
        proxy_pass http://127.0.0.1:3456;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
