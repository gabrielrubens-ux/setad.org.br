# Renomeie para deploy.yml e configure secrets no GitHub:
# DEPLOY_HOST, DEPLOY_USER, DEPLOY_SSH_KEY
#
# O VPS ainda precisa de deploy key para git pull (ver docs/DEPLOY.md).

name: Deploy SETAD

on:
  push:
    branches: [main]

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Deploy via SSH
        uses: appleboy/ssh-action@v1.2.0
        with:
          host: ${{ secrets.DEPLOY_HOST }}
          username: ${{ secrets.DEPLOY_USER }}
          key: ${{ secrets.DEPLOY_SSH_KEY }}
          script: |
            set -e
            cd /var/www/setad
            git pull
            npm ci --omit=dev
            pm2 restart setad || pm2 start ecosystem.config.cjs
